{
  "$description": "Semantic colour roles, dark theme. Must define exactly the roles the light theme does.",
  "color": {
    "$type": "color",
    "bg": { "$value": "{color.neutral.950}" },
    "surface": { "$value": "{color.neutral.900}" },
    "surface-sunken": { "$value": "{color.neutral.800}" },
    "text": { "$value": "{color.neutral.50}" },
    "text-muted": { "$value": "{color.neutral.300}" },
