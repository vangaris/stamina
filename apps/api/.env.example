# Local development: `pnpm --filter @stamina/api db:dev` prints this URL.
DATABASE_URL=postgres://stamina:stamina@127.0.0.1:54329/stamina
# Neon Auth `base_url` (Neon console > Auth; it ends with `/auth`). The API verifies sign-in JWTs
# against `<base>/.well-known/jwks.json`; the token issuer is this URL's origin.
NEON_AUTH_BASE_URL=https://ep-example.neonauth.eu-central-1.aws.neon.tech/neondb/auth
# Comma-separated web origins allowed to call the API. `https://*.host` matches subdomains.
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173,http://localhost:5173
# Optional. Sentry EU DSN (*.de.sentry.io); unset disables error reporting.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
