        },
        "exercise_slots_valid": {
          "name": "exercise_slots_valid",
          "value": "\"exercise\".\"slots\" <@ ARRAY['warm-up', 'main-strength', 'sport-support', 'accessories-core', 'cool-down']::text[]"
        },
        "exercise_slots_count": {
          "name": "exercise_slots_count",
          "value": "cardinality(\"exercise\".\"slots\") between 1 and 2"
        },
        "exercise_locations_not_empty": {
          "name": "exercise_locations_not_empty",
          "value": "cardinality(\"exercise\".\"locations\") > 0"
        },
        "exercise_instructions_not_empty": {
          "name": "exercise_instructions_not_empty",
          "value": "cardinality(\"exercise\".\"instructions_en\") > 0"
        },
