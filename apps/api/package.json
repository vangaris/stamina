{
  "name": "@stamina/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.node.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev:worker": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "db:dev": "tsx scripts/dev-db.ts"
  },
  "nx": {
    "tags": [
      "type:app",
      "scope:server"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/core": "^11.10.0",
    "@stamina/contracts": "workspace:^",
    "@stamina/safe-log": "workspace:^",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
