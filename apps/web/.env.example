# API origin the app calls (required for a production build).
VITE_API_URL=http://127.0.0.1:8787

# `dev`: fully in-memory services for UI work without Neon (fake auth accepts the code 424242).
# VITE_SERVICES_MODE=dev

# Neon Auth base URL (ends with /auth). `vite` and `vite preview` proxy /auth to it so the
# session cookie stays first-party. Production uses the Pages Function in functions/auth, which
# reads the same value through scripts/ops/write-auth-proxy-config.mjs (NEON_AUTH_BASE_URL).
# AUTH_PROXY_TARGET=https://ep-xxx.neonauth.eu-central-1.aws.neon.tech/neondb/auth
