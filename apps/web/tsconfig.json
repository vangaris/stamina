{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "types": ["node", "vite/client", "vite-plugin-pwa/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "functions/**/*.ts",
    "vite/**/*.ts",
    "e2e/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.ui-kit.config.ts",
    "pwa-assets.config.ts"
  ],
  "exclude": ["functions/auth/[[path]].ts"]
}
